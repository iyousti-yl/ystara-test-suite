# Caddy in front of Ystara (deploy/docker-compose.prod.yml): HTTPS for YSTARA_DOMAIN with a certificate
# from Let's Encrypt, renewed on its own, and plain http on port 80 redirected to it.
# The API sets the security headers itself (Content-Security-Policy, HSTS, ...: apps/api/src/server.ts).
{
	email {$YSTARA_ACME_EMAIL}
}

{$YSTARA_DOMAIN} {
	encode zstd gzip
	# While the API restarts (an update), requests wait up to 10 seconds for it instead of failing at once.
	reverse_proxy api:4000 {
		lb_try_duration 10s
	}
	header -Server
	log {
		output stdout
		# An invitation or reset link's token opens an account: the log keeps the path without it.
		format filter {
			wrap console
			fields {
				request>uri regexp "/(invitations|invite|resets|reset)/[^/?#]+" "/${1}/<token>"
				request>headers>Referer delete
			}
		}
	}
}
