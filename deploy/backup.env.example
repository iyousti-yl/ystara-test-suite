# Copy to /etc/ystara/backup.env on the server, readable by root only (chmod 600): it holds the
# storage keys. Read by deploy/backup.sh and deploy/restore-test.sh (restic, https://restic.net).

# Where the encrypted backups go: an S3-compatible bucket in the EU, at another provider than the
# server, so one provider's outage or a lost account doesn't take both. For example:
#   s3:https://s3.fr-par.scw.cloud/<bucket>/ystara           (Scaleway, Paris)
#   s3:https://fsn1.your-objectstorage.com/<bucket>/ystara   (Hetzner, Falkenstein)
RESTIC_REPOSITORY=s3:https://s3.example.eu/ystara-backups/ystara
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The password that encrypts the backups, alone in its file. Keep a copy in the password manager,
# apart from the server: without it no backup can be read.
RESTIC_PASSWORD_FILE=/etc/ystara/secrets/restic_password

# Optional: a URL to call after each backup and restore test (e.g. a healthchecks.io check), so a
# backup that stops running is noticed. "/fail" is added to it when one fails. Nothing else is sent.
YSTARA_BACKUP_PING_URL=
