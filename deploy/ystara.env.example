# Copy to /etc/ystara/ystara.env on the server (deploy/README.md, step 4). No secrets here:
# Docker Compose reads this file and can print its values. Secrets are files in /etc/ystara/secrets.

# The address people open, without https://. Its DNS A (and AAAA) record must point at this server
# before the first start, so Let's Encrypt can check it.
YSTARA_DOMAIN=app.example.com

# Let's Encrypt writes here about certificates that are about to expire (normally never: Caddy renews them).
YSTARA_ACME_EMAIL=ops@example.com

# The sender of alert emails. The mail server in /etc/ystara/secrets/smtp_url must be allowed to send as it
# (SPF and DKIM of the domain), or the emails land in spam.
YSTARA_SMTP_FROM=Ystara <alerts@example.com>
