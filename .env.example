# Copy to .env.local and fill in. Never commit it.
#
# Why .env.local and not .env: Docker Compose reads .env for ${...} substitution in
# docker-compose.yml, reads a `$` inside a value as a variable, and can print the rest
# of the value in its warnings. So .env may only hold the YSTARA_* ports below; the
# API, worker and tools refuse to start when it holds anything else. Values with a `$`
# in .env.local are safest in single quotes: SECRET='pa$$word'.

# --- Platform ---
# Defaults to the Postgres from docker-compose.yml: postgres://ystara:ystara@localhost:55432/ystara
# DATABASE_URL=
# 32-byte base64 key used to encrypt tenant credentials at rest
MASTER_KEY=change-me-generate-with-openssl-rand-base64-32

# --- Datasphere tenant for local scans and the spike (read-only access is enough) ---
# Log in once with `datasphere login`. The product will store connection details per tenant (encrypted).
DSP_HOST=https://your-tenant.eu10.hcs.cloud.sap
DSP_OAUTH_CLIENT_ID=
DSP_OAUTH_CLIENT_SECRET=
DSP_OAUTH_AUTH_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/authorize
DSP_OAUTH_TOKEN_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/token
DSP_SPACE=YSTARA_TEST
# Database user with SELECT rights only (used from phase 2 for snapshots)
DSP_DB_HOST=
DSP_DB_PORT=443
DSP_DB_USER=
DSP_DB_PASSWORD=

# --- Ports (these two go in .env, not here) ---
# Host ports of the Docker Compose stack. The defaults avoid a Postgres you may already
# run on 5432. To change them, put them in .env so Compose and the tools agree:
# YSTARA_DB_PORT=55432
# YSTARA_API_PORT=4000

# Encrypts the authenticator secrets stored in the database (32 random bytes, base64). Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and don't change it: without the same key, every user has to set up their authenticator again.
MASTER_KEY=
