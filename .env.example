# Copy to .env and fill in. Never commit .env.

# --- Platform ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgres://ystara:ystara@localhost:5432/ystara
# 32-byte base64 key used to encrypt tenant credentials at rest
MASTER_KEY=change-me-generate-with-openssl-rand-base64-32

# --- Datasphere tenant used for the feasibility spike only ---
# The product stores these per tenant in the database (encrypted); the spike reads them from here.
DSP_HOST=https://your-tenant.eu10.hcs.cloud.sap
DSP_OAUTH_CLIENT_ID=
DSP_OAUTH_CLIENT_SECRET=
DSP_OAUTH_AUTH_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/authorize
DSP_OAUTH_TOKEN_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/token
DSP_SPACE=YSTARA_TEST
# Database user (Open SQL schema) for the test space
DSP_DB_HOST=
DSP_DB_PORT=443
DSP_DB_USER=
DSP_DB_PASSWORD=
