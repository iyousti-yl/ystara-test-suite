{
  "permissions": {
    "allow": [
      "Bash(npm run scan *)",
      "Bash(npm run spike:cli)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(datasphere --version)",
      "Bash(npm run check:browser)",
      "Bash(npm run check:browser *)",
      "Bash(npm run check:tenant-content)",
      "Bash(npm run check:tenant-content *)"
    ],
    "deny": [
      "Bash(datasphere * create *)",
      "Bash(datasphere * create)",
      "Bash(datasphere * update *)",
      "Bash(datasphere * update)",
      "Bash(datasphere * delete *)",
      "Bash(datasphere * delete)",
      "Bash(datasphere * run *)",
      "Bash(datasphere * run)",
      "Bash(datasphere tasks *)",
      "Bash(datasphere * tasks *)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--no-index*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.master-key)"
    ]
  }
}
