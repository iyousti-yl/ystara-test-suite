{
  "name": "ystara-test-suite",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Ystara Test Suite: regression and scenario testing for SAP Datasphere pipelines",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @ystara/web",
    "typecheck": "tsc -b && tsc -p tools/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "prepare": "node -e \"try { const git = (...a) => require('child_process').execFileSync('git', a, { encoding: 'utf8', stdio: 'pipe' }); if (git('rev-parse', '--is-inside-work-tree').trim() === 'true') git('config', 'core.hooksPath', '.githooks'); } catch {}\"",
    "test": "npm run test --workspaces --if-present && vitest run --dir tools",
    "lint": "eslint .",
    "dev:api": "npm run dev -w @ystara/api",
    "dev:worker": "npm run dev -w @ystara/worker",
    "dev:web": "tsc -b && npm run dev -w @ystara/web",
    "spike:cli": "tsc -b && node tools/spike/cli-capabilities.mjs",
    "spike:technical-client": "tsc -b && tsx tools/spike/technical-client.ts",
    "spike:sql": "tsc -b && tsx tools/spike/sql-access.ts",
    "spike:simulate": "tsc -b && tsx tools/spike/simulate.ts",
    "scan": "tsc -b && tsx tools/scan/scan.ts",
    "db:migrate": "tsc -b && node packages/db/dist/run-migrations.js",
    "db:import": "tsc -b && tsx tools/db/import-scan.ts",
    "db:demo": "tsc -b && tsx tools/db/load-demo.ts",
    "account:create": "tsc -b && tsx tools/db/create-account.ts",
    "operator:grant": "tsc -b && tsx tools/db/operator-grant.ts",
    "check:browser": "tsc -b && tsx tools/check/browser.ts",
    "check:tenant-content": "tsc -b && tsx tools/check/tenant-content.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "1.56.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
